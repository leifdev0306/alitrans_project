{% extends 'emails/base.html' %}
{% block title %}Envíos - Alitrans{% endblock %}
{% block content %}
<div class="page-header">
    <h1><i class="bi bi-send-fill"></i> Gestión de Envíos</h1>
    <a href="{% url 'emails:crear_envio' %}" class="btn-ali">
        <i class="bi bi-plus-lg"></i> Nueva campaña</a>
</div>

<div class="card-ali mb-4">
    <div class="d-flex gap-2 flex-wrap">
        <a href="?filtro=todos" class="btn-ali-outline {% if filtro == 'todos' %}btn-ali{% endif %}" style="padding:7px 16px;font-size:0.85rem;">Todos ({{ contadores.todos }})</a>
        <a href="?filtro=borrador" class="btn-ali-outline {% if filtro == 'borrador' %}btn-ali{% endif %}" style="padding:7px 16px;font-size:0.85rem;">Borradores ({{ contadores.borrador }})</a>
        <a href="?filtro=programado" class="btn-ali-outline {% if filtro == 'programado' %}btn-ali{% endif %}" style="padding:7px 16px;font-size:0.85rem;">Programados ({{ contadores.programado }})</a>
        <a href="?filtro=enviado" class="btn-ali-outline {% if filtro == 'enviado' %}btn-ali{% endif %}" style="padding:7px 16px;font-size:0.85rem;">Enviados ({{ contadores.enviado }})</a>
        <a href="?filtro=fallido" class="btn-ali-outline {% if filtro == 'fallido' %}btn-ali{% endif %}" style="padding:7px 16px;font-size:0.85rem;">Fallidos ({{ contadores.fallido }})</a>
    </div>
</div>

<div class="card-ali">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr style="font-size:0.78rem;color:#94a3b8;text-transform:uppercase;">
                    <th>Campaña</th><th>Oferta</th><th>Tipo</th>
                    <th>Destinatarios</th><th>Estado</th>
                    <th>Programado</th><th>Enviados</th>
                    <th style="text-align:right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% for envio in envios %}
                <tr>
                    <td>
                        <a href="{% url 'emails:detalle_envio' envio.pk %}"
                           class="text-decoration-none fw-semibold"
                           style="color:var(--ali-primary);">{{ envio.nombre_campana }}</a>
                        <div style="font-size:0.75rem;color:#94a3b8;">
                            Creado: {{ envio.fecha_creacion|date:"d/m/Y H:i" }}</div>
                    </td>
                    <td style="font-size:0.88rem;">{{ envio.oferta.titulo|truncatechars:30 }}</td>
                    <td><span class="badge-soft badge-soft-info">{{ envio.get_tipo_envio_display }}</span></td>
                    <td style="font-size:0.85rem;">
                        {% if envio.enviar_a_todos %}<i class="bi bi-people-fill"></i> Todos
                        {% else %}<i class="bi bi-person-fill"></i> {{ envio.destinatarios.count }}{% endif %}
                    </td>
                    <td>
                        {% if envio.estado == 'enviado' %}<span class="badge-soft badge-soft-success"><i class="bi bi-check-circle-fill"></i> Enviado</span>
                        {% elif envio.estado == 'programado' %}<span class="badge-soft badge-soft-warning"><i class="bi bi-clock-fill"></i> Programado</span>
                        {% elif envio.estado == 'enviando' %}<span class="badge-soft badge-soft-info"><i class="bi bi-arrow-repeat"></i> Enviando</span>
                        {% elif envio.estado == 'fallido' %}<span class="badge-soft badge-soft-danger"><i class="bi bi-x-circle-fill"></i> Fallido</span>
                        {% elif envio.estado == 'cancelado' %}<span class="badge-soft badge-soft-secondary">Cancelado</span>
                        {% else %}<span class="badge-soft badge-soft-secondary">Borrador</span>{% endif %}
                    </td>
                    <td style="font-size:0.82rem;">
                        {% if envio.fecha_programada %}{{ envio.fecha_programada|date:"d/m/Y H:i" }}{% else %}—{% endif %}
                    </td>
                    <td><strong>{{ envio.total_enviados }}</strong>
                        {% if envio.total_fallidos %}<span class="text-danger small"> / {{ envio.total_fallidos }} err</span>{% endif %}</td>
                    <td style="text-align:right;">
                        <div class="d-flex gap-1 justify-content-end">
                            <a href="{% url 'emails:detalle_envio' envio.pk %}"
                               class="btn-ali-outline" style="padding:5px 10px;font-size:0.78rem;">
                                <i class="bi bi-eye"></i></a>
                            {% if envio.estado == 'borrador' or envio.estado == 'programado' %}
                                <a href="{% url 'emails:lanzar_envio' envio.pk %}"
                                   class="btn-ali" style="padding:5px 10px;font-size:0.78rem;background:#10b981;"
                                   onclick="return confirm('¿Lanzar este envío ahora?')">
                                    <i class="bi bi-send"></i></a>
                                <a href="{% url 'emails:editar_envio' envio.pk %}"
                                   class="btn-ali-outline" style="padding:5px 10px;font-size:0.78rem;">
                                    <i class="bi bi-pencil"></i></a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% empty %}
                <tr><td colspan="8" class="text-center text-muted py-5">
                    <i class="bi bi-inbox" style="font-size:2.5rem;color:#cbd5e1;"></i>
                    <p class="mt-2">No hay envíos registrados.</p>
                    <a href="{% url 'emails:crear_envio' %}" class="btn-ali">
                        <i class="bi bi-plus-lg"></i> Crear primera campaña</a>
                </td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}